DEBUG=True
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///db.sqlite3

# Domaine racine utilisé par Django pour résoudre les tenants en production.
# Exemple si l'application principale est sur prototype.bewiseinnovation.com :
# BASE_DOMAIN=prototype.bewiseinnovation.com
BASE_DOMAIN=school.bewiseinnovation.com

ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.bewiseinnovation.com
CORS_ALLOW_ALL_ORIGINS=True

# Optionnel : base publique utilisée dans les QR codes des bulletins.
# Exemple production : https://school.bewiseinnovation.com/verify/report-card
REPORT_CARD_VERIFY_BASE_URL=

# WhatsApp / n8n parent documents agent
WHATSAPP_AGENT_API_KEY=replace-with-a-long-random-secret
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-with-evolution-global-api-key
EVOLUTION_API_TIMEOUT=30
WHATSAPP_DEFAULT_COUNTRY_CODE=237
# True locally: tool calls are simulated and do not contact Evolution API.
WHATSAPP_AI_DRY_RUN=True
