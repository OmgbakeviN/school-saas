FRENCH_PRIMARY = ["SIL", "CP", "CE1", "CE2", "CM1", "CM2"]
ENGLISH_PRIMARY = ["Class 1", "Class 2", "Class 3", "Class 4", "Class 5", "Class 6"]

FRENCH_SECONDARY = ["6e", "5e", "4e", "3e", "2nde", "1ère", "Terminale"]
ENGLISH_SECONDARY = [
    "Form 1",
    "Form 2",
    "Form 3",
    "Form 4",
    "Form 5",
    "Lower Sixth",
    "Upper Sixth",
]


def _section_templates(school):
    if school.language_mode == "BILINGUAL":
        return [
            ("Section francophone", "fr", Section.Language.FRENCH),
            ("English section", "en", Section.Language.ENGLISH),
        ]

    if school.language_mode == "ENGLISH":
        return [("English section", "en", Section.Language.ENGLISH)]

    return [("Section francophone", "fr", Section.Language.FRENCH)]


def _cycle_templates(school, language):
    cycles = []

    if school.education_level in {"PRIMARY", "PRIMARY_SECONDARY"}:
        if language == Section.Language.ENGLISH:
            cycles.append(("Primary", "primary", Cycle.Kind.PRIMARY, ENGLISH_PRIMARY))
        else:
            cycles.append(("Primaire", "primaire", Cycle.Kind.PRIMARY, FRENCH_PRIMARY))

    if school.education_level in {"SECONDARY", "PRIMARY_SECONDARY"}:
        if language == Section.Language.ENGLISH:
            cycles.append(("Secondary", "secondary", Cycle.Kind.SECONDARY, ENGLISH_SECONDARY))
        else:
            cycles.append(("Secondaire", "secondaire", Cycle.Kind.SECONDARY, FRENCH_SECONDARY))

    return cycles


@extend_schema(request=OpenApiTypes.OBJECT, responses={200: OpenApiTypes.OBJECT}, tags=["Academics"])
@api_view(["POST"])
@permission_classes([IsSchoolAdministrator])
@transaction.atomic
def bootstrap_structure(request):
    school = request.school
    created = {
        "sections": 0,
        "cycles": 0,
        "levels": 0,
    }

    for section_order, (section_name, section_code, language) in enumerate(
        _section_templates(school),
        start=1,
    ):
        section, was_created = Section.objects.get_or_create(
            school=school,
            code=section_code,
            defaults={
                "name": section_name,
                "language": language,
                "order": section_order,
            },
        )
        if was_created:
            created["sections"] += 1

        for cycle_order, (cycle_name, cycle_code_base, kind, level_names) in enumerate(
            _cycle_templates(school, language),
            start=1,
        ):
            cycle_code = f"{section.code}-{cycle_code_base}"
            cycle, was_created = Cycle.objects.get_or_create(
                school=school,
                code=cycle_code,
                defaults={
                    "section": section,
                    "name": cycle_name,
                    "kind": kind,
                    "order": cycle_order,
                },
            )
            if was_created:
                created["cycles"] += 1

            for level_order, level_name in enumerate(level_names, start=1):
                level_code = slugify(level_name)
                _, was_created = Level.objects.get_or_create(
                    school=school,
                    cycle=cycle,
                    code=level_code,
                    defaults={
                        "name": level_name,
                        "order": level_order,
                    },
                )
                if was_created:
                    created["levels"] += 1

    return Response({
        "message": "Structure suggérée générée. Vous pouvez maintenant la modifier.",
        "created": created,
    })


