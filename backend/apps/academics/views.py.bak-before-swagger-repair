@extend_schema(request=OpenApiTypes.OBJECT, responses={200: OpenApiTypes.OBJECT}, tags=["Academics"])
@api_view(["GET", "PATCH"])
@permission_classes([AcademicStructurePermission])
def academic_policy(request):
    policy, _ = AcademicPolicy.objects.get_or_create(
        school=request.school,
    )

    if request.method == "GET":
        return Response(
            AcademicPolicySerializer(
                policy,
                context={"request": request},
            ).data
        )

    serializer = AcademicPolicySerializer(
        policy,
        data=request.data,
        partial=True,
        context={"request": request},
    )
    serializer.is_valid(raise_exception=True)
    serializer.save()

    return Response(serializer.data)


@extend_schema(request=OpenApiTypes.OBJECT, responses={200: OpenApiTypes.OBJECT}, tags=["Academics"])
@api_view(["POST"])
@permission_classes([IsSchoolAdministrator])
@transaction.atomic
def bootstrap_periods(request):
    academic_year_id = request.data.get("academic_year")

    academic_year = AcademicYear.objects.filter(
        id=academic_year_id,
        school=request.school,
    ).first()

    if not academic_year:
        return Response(
            {"detail": "Année scolaire introuvable."},
            status=status.HTTP_404_NOT_FOUND,
        )

    if academic_year.period_system == AcademicYear.PeriodSystem.CUSTOM:
        return Response(
            {
                "detail": (
                    "Cette année utilise un découpage personnalisé. "
                    "Créez les périodes manuellement."
                )
            },
            status=status.HTTP_400_BAD_REQUEST,
        )

    if academic_year.period_system == AcademicYear.PeriodSystem.SEMESTER:
        count = 2
        kind = AcademicPeriod.Kind.SEMESTER
        french_prefix = "Semestre"
        english_prefix = "Semester"
    else:
        count = 3
        kind = AcademicPeriod.Kind.TRIMESTER
        french_prefix = "Trimestre"
        english_prefix = "Term"

    english_school = request.school.language_mode == "ENGLISH"
    prefix = english_prefix if english_school else french_prefix

    created = 0

    for order in range(1, count + 1):
        _, was_created = AcademicPeriod.objects.get_or_create(
            school=request.school,
            academic_year=academic_year,
            code=f"{kind.lower()}-{order}",
            defaults={
                "name": f"{prefix} {order}",
                "kind": kind,
                "order": order,
                "weight": 1,
            },
        )

        if was_created:
            created += 1

    return Response({
        "message": "Périodes générées.",
        "created": created,
    })


@extend_schema(request=OpenApiTypes.OBJECT, responses={200: OpenApiTypes.OBJECT}, tags=["Academics"])
@api_view(["POST"])
@permission_classes([IsSchoolAdministrator])
def bulk_assign_subject(request):
    serializer = BulkLevelSubjectAssignmentSerializer(
        data=request.data,
        context={"request": request},
    )
    serializer.is_valid(raise_exception=True)
    result = serializer.save()

    return Response(
        {
            "created_count": result["created_count"],
            "updated_count": result["updated_count"],
            "assignments": LevelSubjectSerializer(
                result["assignments"],
                many=True,
                context={"request": request},
            ).data,
        },
        status=status.HTTP_200_OK,
    )
