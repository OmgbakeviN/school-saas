class TenantModelSerializer(serializers.ModelSerializer):
    def get_school(self):
        return self.context["request"].school


class AcademicYearSerializer(TenantModelSerializer):
    class Meta:
        model = AcademicYear
        fields = [
            "id",
            "name",
            "start_date",
            "end_date",
            "period_system",
            "is_active",
            "is_closed",
            "created_at",
        ]
        read_only_fields = ("created_at",)

    def validate(self, attrs):
        start = attrs.get("start_date", getattr(self.instance, "start_date", None))
        end = attrs.get("end_date", getattr(self.instance, "end_date", None))

        if start and end and start >= end:
            raise serializers.ValidationError({
                "end_date": "La date de fin doit être postérieure à la date de début."
            })
        return attrs

    @transaction.atomic
    def create(self, validated_data):
        school = self.get_school()

        if validated_data.get("is_active"):
            AcademicYear.objects.filter(school=school, is_active=True).update(is_active=False)

        return AcademicYear.objects.create(school=school, **validated_data)

    @transaction.atomic
    def update(self, instance, validated_data):
        if validated_data.get("is_active"):
            AcademicYear.objects.filter(
                school=instance.school,
                is_active=True,
            ).exclude(pk=instance.pk).update(is_active=False)

        return super().update(instance, validated_data)


