        read_only=True,
    )
    subject_code = serializers.CharField(
        source="subject.code",
        read_only=True,
    )
    level_name = serializers.CharField(
        source="level.name",
        read_only=True,
    )
    cycle_name = serializers.CharField(
        source="level.cycle.name",
        read_only=True,
    )
    section_name = serializers.CharField(
        source="level.cycle.section.name",
        read_only=True,
    )
    effective_max_score = serializers.SerializerMethodField()

    class Meta:
        model = LevelSubject
        fields = [
            "id",
            "level",
            "level_name",
            "cycle_name",
            "section_name",
            "subject",
            "subject_name",
            "subject_code",
            "coefficient",
            "max_score_override",
            "effective_max_score",
            "teaching_language",
            "order",
            "is_active",
        ]

    def get_effective_max_score(self, obj):
        policy, _ = AcademicPolicy.objects.get_or_create(
            school=obj.school,
        )

        if obj.max_score_override is not None:
            return obj.max_score_override

        if obj.level.max_score_override is not None:
            return obj.level.max_score_override

        if obj.level.cycle.max_score_override is not None:
            return obj.level.cycle.max_score_override

        return policy.default_max_score

    def validate_level(self, level):
        if level.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Ce niveau n'appartient pas à votre établissement."
            )
        return level

    def validate_subject(self, subject):
        if subject.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Cette matière n'appartient pas à votre établissement."
            )
        return subject

    def validate(self, attrs):
        coefficient = attrs.get(
            "coefficient",
            getattr(self.instance, "coefficient", 1),
        )
        max_score = attrs.get(
            "max_score_override",
            getattr(self.instance, "max_score_override", None),
        )

        if coefficient <= 0:
            raise serializers.ValidationError({
                "coefficient": "Le coefficient doit être supérieur à zéro."
            })

        if max_score is not None and max_score <= 0:
            raise serializers.ValidationError({
                "max_score_override": "La note maximale doit être supérieure à zéro."
            })

        return attrs

    def create(self, validated_data):
        return LevelSubject.objects.create(
            school=self.get_school(),
            **validated_data,
        )


class BulkLevelSubjectAssignmentSerializer(serializers.Serializer):
    subject = serializers.PrimaryKeyRelatedField(
        queryset=Subject.objects.all(),
    )
    levels = serializers.PrimaryKeyRelatedField(
        queryset=Level.objects.all(),
        many=True,
        allow_empty=False,
    )
    coefficient = serializers.DecimalField(
        max_digits=7,
        decimal_places=3,
        min_value=0.001,
    )
    max_score_override = serializers.DecimalField(
        max_digits=7,
        decimal_places=2,
        min_value=0.01,
        required=False,
        allow_null=True,
    )
    teaching_language = serializers.ChoiceField(
        choices=Subject.Language.choices,
        default=Subject.Language.DEFAULT,
    )
    order = serializers.IntegerField(
        min_value=0,
        default=0,
    )
    is_active = serializers.BooleanField(default=True)

    def validate_subject(self, subject):
        school = self.context["request"].school
        if subject.school_id != school.id:
            raise serializers.ValidationError(
                "Cette matière n'appartient pas à votre établissement."
            )
        return subject

    def validate_levels(self, levels):
        school = self.context["request"].school

        invalid = [
            level.id
            for level in levels
            if level.school_id != school.id
        ]

        if invalid:
            raise serializers.ValidationError(
                "Un ou plusieurs niveaux n'appartiennent pas à votre établissement."
            )

        ids = [level.id for level in levels]
        if len(ids) != len(set(ids)):
            raise serializers.ValidationError(
                "Un même niveau ne peut pas être sélectionné deux fois."
            )

        return levels

    @transaction.atomic
    def create(self, validated_data):
        school = self.context["request"].school
        subject = validated_data["subject"]
        levels = validated_data["levels"]

        defaults = {
            "coefficient": validated_data["coefficient"],
            "max_score_override": validated_data.get(
                "max_score_override"
            ),
            "teaching_language": validated_data[
                "teaching_language"
            ],
            "order": validated_data["order"],
            "is_active": validated_data["is_active"],
        }

        created_count = 0
        updated_count = 0
        assignments = []

        for level in levels:
            assignment, created = LevelSubject.objects.update_or_create(
                school=school,
                level=level,
                subject=subject,
                defaults=defaults,
            )
            assignments.append(assignment)

            if created:
                created_count += 1
            else:
                updated_count += 1

        return {
            "assignments": assignments,
            "created_count": created_count,
            "updated_count": updated_count,
        }
