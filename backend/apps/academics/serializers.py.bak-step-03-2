class CycleSerializer(TenantModelSerializer):
    section_name = serializers.CharField(source="section.name", read_only=True)
    section_language = serializers.CharField(source="section.language", read_only=True)
    effective_max_score = serializers.SerializerMethodField()
    effective_promotion_threshold = serializers.SerializerMethodField()

    class Meta:
        model = Cycle
        fields = [
            "id",
            "section",
            "section_name",
            "section_language",
            "name",
            "code",
            "kind",
            "order",
            "is_active",
            "max_score_override",
            "promotion_threshold_override",
            "effective_max_score",
            "effective_promotion_threshold",
        ]

    def validate_code(self, value):
        return slugify(value)

    def validate_section(self, section):
        if section.school_id != self.get_school().id:
            raise serializers.ValidationError("Cette section n'appartient pas à votre établissement.")
        return section

    def get_effective_max_score(self, obj):
        policy, _ = AcademicPolicy.objects.get_or_create(school=obj.school)
        return obj.max_score_override if obj.max_score_override is not None else policy.default_max_score

    def get_effective_promotion_threshold(self, obj):
        policy, _ = AcademicPolicy.objects.get_or_create(school=obj.school)
        return (
            obj.promotion_threshold_override
            if obj.promotion_threshold_override is not None
            else policy.default_promotion_threshold
        )

    def validate(self, attrs):
        policy, _ = AcademicPolicy.objects.get_or_create(
            school=self.get_school()
        )
        max_override = attrs.get(
            "max_score_override",
            getattr(self.instance, "max_score_override", None),
        )
        threshold_override = attrs.get(
            "promotion_threshold_override",
            getattr(self.instance, "promotion_threshold_override", None),
        )

        effective_max = (
            max_override
            if max_override is not None
            else policy.default_max_score
        )
        effective_threshold = (
            threshold_override
            if threshold_override is not None
            else policy.default_promotion_threshold
        )

        if effective_max <= 0:
            raise serializers.ValidationError({
                "max_score_override": "La note maximale doit être supérieure à zéro."
            })
        if effective_threshold < 0 or effective_threshold > effective_max:
            raise serializers.ValidationError({
                "promotion_threshold_override": "Le seuil doit être compris entre 0 et la note maximale effective."
            })
        return attrs

    def create(self, validated_data):
        return Cycle.objects.create(school=self.get_school(), **validated_data)


class LevelSerializer(TenantModelSerializer):
    cycle_name = serializers.CharField(source="cycle.name", read_only=True)
    section_id = serializers.IntegerField(source="cycle.section_id", read_only=True)
    section_name = serializers.CharField(source="cycle.section.name", read_only=True)

    class Meta:
        model = Level
        fields = [
            "id",
            "cycle",
            "cycle_name",
            "section_id",
            "section_name",
            "name",
            "code",
            "order",
            "is_active",
            "max_score_override",
            "promotion_threshold_override",
            "effective_max_score",
            "effective_promotion_threshold",
        ]

    effective_max_score = serializers.SerializerMethodField()
    effective_promotion_threshold = serializers.SerializerMethodField()

    def get_effective_max_score(self, obj):
        policy, _ = AcademicPolicy.objects.get_or_create(school=obj.school)
        if obj.max_score_override is not None:
            return obj.max_score_override
        if obj.cycle.max_score_override is not None:
            return obj.cycle.max_score_override
        return policy.default_max_score

    def get_effective_promotion_threshold(self, obj):
        policy, _ = AcademicPolicy.objects.get_or_create(school=obj.school)
        if obj.promotion_threshold_override is not None:
            return obj.promotion_threshold_override
        if obj.cycle.promotion_threshold_override is not None:
            return obj.cycle.promotion_threshold_override
        return policy.default_promotion_threshold

    def validate_code(self, value):
        return slugify(value)

    def validate(self, attrs):
        cycle = attrs.get(
            "cycle",
            getattr(self.instance, "cycle", None),
        )
        policy, _ = AcademicPolicy.objects.get_or_create(
            school=self.get_school()
        )
        max_override = attrs.get(
            "max_score_override",
            getattr(self.instance, "max_score_override", None),
        )
        threshold_override = attrs.get(
            "promotion_threshold_override",
            getattr(self.instance, "promotion_threshold_override", None),
        )

        inherited_max = (
            cycle.max_score_override
            if cycle and cycle.max_score_override is not None
            else policy.default_max_score
        )
        inherited_threshold = (
            cycle.promotion_threshold_override
            if cycle and cycle.promotion_threshold_override is not None
            else policy.default_promotion_threshold
        )

        effective_max = (
            max_override
            if max_override is not None
            else inherited_max
        )
        effective_threshold = (
            threshold_override
            if threshold_override is not None
            else inherited_threshold
        )

        if effective_max <= 0:
            raise serializers.ValidationError({
                "max_score_override": "La note maximale doit être supérieure à zéro."
            })
        if effective_threshold < 0 or effective_threshold > effective_max:
            raise serializers.ValidationError({
                "promotion_threshold_override": "Le seuil doit être compris entre 0 et la note maximale effective."
            })
        return attrs

    def validate_cycle(self, cycle):
        if cycle.school_id != self.get_school().id:
            raise serializers.ValidationError("Ce cycle n'appartient pas à votre établissement.")
        return cycle

    def create(self, validated_data):
        return Level.objects.create(school=self.get_school(), **validated_data)


