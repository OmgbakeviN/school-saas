class StudentGuardianSerializer(TenantModelSerializer):
    student_name = serializers.SerializerMethodField()
    student_matricule = serializers.CharField(
        source="student.matricule",
        read_only=True,
    )
    guardian_name = serializers.SerializerMethodField()
    guardian_phone = serializers.CharField(
        source="guardian.phone",
        read_only=True,
    )
    relationship_label = serializers.CharField(
        source="get_relationship_display",
        read_only=True,
    )

    class Meta:
        model = StudentGuardian
        fields = [
            "id",
            "student",
            "student_name",
            "student_matricule",
            "guardian",
            "guardian_name",
            "guardian_phone",
            "relationship",
            "relationship_label",
            "is_primary",
            "receives_notifications",
            "can_receive_results",
            "created_at",
        ]
        read_only_fields = ("created_at",)

    def get_student_name(self, obj):
        return f"{obj.student.last_name} {obj.student.first_name}".strip()

    def get_guardian_name(self, obj):
        return f"{obj.guardian.last_name} {obj.guardian.first_name}".strip()

    def validate_student(self, student):
        if student.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Cet élève n'appartient pas à votre établissement."
            )
        return student

    def validate_guardian(self, guardian):
        if guardian.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Ce parent/tuteur n'appartient pas à votre établissement."
            )
        return guardian

    def validate(self, attrs):
        school = self.get_school()
        student = attrs.get(
            "student",
            getattr(self.instance, "student", None),
        )
        guardian = attrs.get(
            "guardian",
            getattr(self.instance, "guardian", None),
        )

        queryset = StudentGuardian.objects.filter(
            school=school,
            student=student,
            guardian=guardian,
        )
        if self.instance:
            queryset = queryset.exclude(pk=self.instance.pk)

        if queryset.exists():
            raise serializers.ValidationError(
                "Ce parent/tuteur est déjà lié à cet élève."
            )

        return attrs

    @transaction.atomic
    def create(self, validated_data):
        school = self.get_school()
        student = validated_data["student"]

        if validated_data.get("is_primary"):
            StudentGuardian.objects.filter(
                school=school,
                student=student,
                is_primary=True,
            ).update(is_primary=False)

        return StudentGuardian.objects.create(
            school=school,
            **validated_data,
        )

    @transaction.atomic
    def update(self, instance, validated_data):
        if validated_data.get("is_primary"):
            StudentGuardian.objects.filter(
                school=instance.school,
                student=instance.student,
                is_primary=True,
            ).exclude(pk=instance.pk).update(is_primary=False)

        return super().update(instance, validated_data)


class EnrollmentSerializer(TenantModelSerializer):
    student_name = serializers.SerializerMethodField()
    student_matricule = serializers.CharField(
        source="student.matricule",
        read_only=True,
    )
    academic_year_name = serializers.CharField(
        source="academic_year.name",
        read_only=True,
    )
    classroom_name = serializers.CharField(
        source="classroom.name",
        read_only=True,
    )
    level_name = serializers.CharField(
        source="classroom.level.name",
        read_only=True,
    )
    cycle_name = serializers.CharField(
        source="classroom.level.cycle.name",
        read_only=True,
    )
    section_name = serializers.CharField(
        source="classroom.level.cycle.section.name",
        read_only=True,
    )
    promotion_decision_label = serializers.CharField(
        source="get_promotion_decision_display",
        read_only=True,
    )

    class Meta:
        model = Enrollment
        fields = [
            "id",
            "student",
            "student_name",
            "student_matricule",
            "academic_year",
            "academic_year_name",
            "classroom",
            "classroom_name",
            "level_name",
            "cycle_name",
            "section_name",
            "enrollment_date",
            "roll_number",
            "status",
            "final_average",
            "promotion_decision",
            "promotion_decision_label",
            "decision_reason",
            "next_enrollment",
            "created_at",
            "updated_at",
        ]
        read_only_fields = ("created_at", "updated_at")

    def get_student_name(self, obj):
        return f"{obj.student.last_name} {obj.student.first_name}".strip()

    def validate_student(self, student):
        if student.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Cet élève n'appartient pas à votre établissement."
            )
        return student

    def validate_academic_year(self, academic_year):
        if academic_year.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Cette année scolaire n'appartient pas à votre établissement."
            )
        return academic_year

    def validate_classroom(self, classroom):
        if classroom.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "Cette classe n'appartient pas à votre établissement."
            )
        return classroom

    def validate_next_enrollment(self, next_enrollment):
        if next_enrollment and next_enrollment.school_id != self.get_school().id:
            raise serializers.ValidationError(
                "L'inscription suivante n'appartient pas à cet établissement."
            )
        return next_enrollment

    def validate(self, attrs):
        school = self.get_school()

        student = attrs.get(
            "student",
            getattr(self.instance, "student", None),
        )
        year = attrs.get(
            "academic_year",
            getattr(self.instance, "academic_year", None),
        )
        classroom = attrs.get(
            "classroom",
            getattr(self.instance, "classroom", None),
        )

        if classroom and year and classroom.academic_year_id != year.id:
            raise serializers.ValidationError({
                "classroom": (
                    "La classe doit appartenir à l'année scolaire sélectionnée."
                )
            })

        queryset = Enrollment.objects.filter(
            school=school,
            student=student,
            academic_year=year,
        )

        if self.instance:
            queryset = queryset.exclude(pk=self.instance.pk)

        if queryset.exists():
            raise serializers.ValidationError({
                "student": "Cet élève possède déjà une inscription pour cette année scolaire."
            })

        return attrs

    def create(self, validated_data):
        return Enrollment.objects.create(
            school=self.get_school(),
            **validated_data,
        )


