def _next_code(model, school, field_name, prefix):
    existing = set(
        model.objects.filter(school=school).values_list(
            field_name,
            flat=True,
        )
    )
    index = model.objects.filter(school=school).count() + 1

    while True:
        candidate = f"{prefix}-{index:05d}"
        if candidate not in existing:
            return candidate
        index += 1


class TenantModelSerializer(serializers.ModelSerializer):
    def get_school(self):
        return self.context["request"].school


class StudentSerializer(TenantModelSerializer):
    matricule = serializers.CharField(required=False, allow_blank=True, max_length=60)
    current_enrollment = serializers.SerializerMethodField()

    class Meta:
        model = Student
        fields = [
            "id",
            "matricule",
            "first_name",
            "last_name",
            "gender",
            "date_of_birth",
            "place_of_birth",
            "nationality",
            "address",
            "phone",
            "email",
            "admission_date",
            "status",
            "notes",
            "current_enrollment",
            "created_at",
            "updated_at",
        ]
        read_only_fields = ("created_at", "updated_at")

    def get_current_enrollment(self, obj):
        enrollment = (
            obj.enrollments
            .select_related("academic_year", "classroom")
            .filter(academic_year__is_active=True)
            .first()
        )

        if not enrollment:
            return None

        return {
            "id": enrollment.id,
            "academic_year": enrollment.academic_year_id,
            "academic_year_name": enrollment.academic_year.name,
            "classroom": enrollment.classroom_id,
            "classroom_name": enrollment.classroom.name,
            "status": enrollment.status,
        }

    def validate_matricule(self, value):
        value = value.strip()
        school = self.get_school()

        queryset = Student.objects.filter(
            school=school,
            matricule__iexact=value,
        )

        if self.instance:
            queryset = queryset.exclude(pk=self.instance.pk)

        if value and queryset.exists():
            raise serializers.ValidationError(
                "Ce matricule est déjà utilisé dans cet établissement."
            )

        return value

    def create(self, validated_data):
        school = self.get_school()

        if not validated_data.get("matricule"):
            validated_data["matricule"] = _next_code(
                Student,
                school,
                "matricule",
                "STU",
            )

        return Student.objects.create(
            school=school,
            **validated_data,
        )


class TeacherSerializer(TenantModelSerializer):
    employee_number = serializers.CharField(required=False, allow_blank=True, max_length=60)
    linked_account = serializers.SerializerMethodField()

    class Meta:
        model = Teacher
        fields = [
            "id",
            "user",
            "linked_account",
            "employee_number",
            "first_name",
            "last_name",
            "phone",
            "email",
            "speciality",
            "hire_date",
            "status",
            "notes",
            "created_at",
            "updated_at",
        ]
        read_only_fields = ("created_at", "updated_at")

    def get_linked_account(self, obj):
        if not obj.user:
            return None

        return {
            "id": obj.user_id,
            "email": obj.user.email,
            "first_name": obj.user.first_name,
            "last_name": obj.user.last_name,
        }

    def validate_employee_number(self, value):
        value = value.strip()
        school = self.get_school()

        queryset = Teacher.objects.filter(
            school=school,
            employee_number__iexact=value,
        )

        if self.instance:
            queryset = queryset.exclude(pk=self.instance.pk)

        if value and queryset.exists():
            raise serializers.ValidationError(
                "Ce matricule enseignant est déjà utilisé."
            )

        return value

    def validate_user(self, user):
        if user is None:
            return user

        school = self.get_school()

        membership = SchoolMembership.objects.filter(
            school=school,
            user=user,
            is_active=True,
            role=SchoolMembership.Role.TEACHER,
        ).exists()

        if not membership:
            raise serializers.ValidationError(
                "Le compte sélectionné doit être un enseignant actif de cet établissement."
            )

        queryset = Teacher.objects.filter(
            school=school,
            user=user,
        )
        if self.instance:
            queryset = queryset.exclude(pk=self.instance.pk)

        if queryset.exists():
            raise serializers.ValidationError(
                "Ce compte est déjà lié à un profil enseignant."
            )

        return user

    def create(self, validated_data):
        school = self.get_school()

        if not validated_data.get("employee_number"):
            validated_data["employee_number"] = _next_code(
                Teacher,
                school,
                "employee_number",
                "TCH",
            )

        return Teacher.objects.create(
            school=school,
            **validated_data,
        )


